# 指标核验原型：复制为 .env.metric-verification 后填写；实际配置已被 .gitignore 排除。
# 两个连接都指向测试环境。不要填生产账号；源连接仅需 SELECT 权限。
MV_ENVIRONMENT=114测试环境
# 首次导入前可用 auto；首个映射生效后改为 required，配置故障时不回退旧文件。
MV_MAPPING_MODE=auto
MV_SOURCE_ENGINE=mysql
MV_SOURCE_HOST=
MV_SOURCE_PORT=3306
MV_SOURCE_DATABASE=edu_source
MV_SOURCE_USER=
MV_SOURCE_PASSWORD=
# Oracle 原库可选：MV_SOURCE_ENGINE=oracle；填写 host/port 和 service name。
MV_SOURCE_SERVICE_NAME=

MV_ANALYTICS_HOST=
MV_ANALYTICS_PORT=3306
MV_ANALYTICS_DATABASE=edu_analytics_v3
MV_ANALYTICS_USER=
MV_ANALYTICS_PASSWORD=

# 有 TLS CA 时校验证书；不填写则沿用测试数据库当前连接方式。
MV_SOURCE_SSL_CA=
MV_ANALYTICS_SSL_CA=
MV_QUERY_TIMEOUT_SECONDS=15
# 核验记录仅写本模块的 sys_metric_verification_* 表，不修改教务数据。
# 完成连接测试后，显式运行 python -m backend.metric_verification.migrate 创建新表。
